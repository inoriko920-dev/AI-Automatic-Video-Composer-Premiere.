{
  "manifestVersion": 5,
  "id": "com.inoriko920.aavc.premiere",
  "name": "AI Automatic Video Composer Premiere",
  "shortname": "AAVC Premiere",
  "version": "0.0.2",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "id": "aavcDiagnosticsPanel",
      "type": "panel",
      "label": {
        "default": "AI Automatic Video Composer"
      },
      "minimumSize": {
        "width": 360,
        "height": 420
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 520,
        "height": 760
      }
    }
  ]
}
